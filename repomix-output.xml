int ApiManager::extractSignatureTimestamp(const QString &script) {
    if (script.isEmpty()) return 0;
    QRegExp rx("(?:signatureTimestamp|sts)\\s*:\\s*(\\d{5})");
    if (rx.indexIn(script) >= 0) return rx.cap(1).toInt();
    return 0;
}

